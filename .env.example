# Copy to .env (git-ignored) and adjust. Never commit real credentials.

# Application under test (required)
APP_BASE_URL=http://127.0.0.1:8765
# Start the bundled app automatically when APP_BASE_URL is local and not running
AUTO_START_APP=true

# Local Ollama (no external LLM APIs are used)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
# Model used by the Resume Updating Agent app itself
AGENT_MODEL=gemma2:2b
# DeepEval judge model (defaults to OLLAMA_MODEL)
JUDGE_MODEL=gemma2:2b
# Per-call timeout for the DeepEval judge (seconds)
JUDGE_TIMEOUT_S=300
OLLAMA_TIMEOUT_S=180
OLLAMA_RETRIES=3

# Browser
HEADLESS=true
SLOW_MO_MS=0
DEFAULT_TIMEOUT_MS=15000
AGENT_TIMEOUT_MS=180000

# DeepEval thresholds
THRESHOLD_ANSWER_RELEVANCY=0.70
THRESHOLD_FAITHFULNESS=0.70
THRESHOLD_HALLUCINATION=0.30
